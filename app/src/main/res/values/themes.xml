<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window and splash screen before Compose draws. Every other colour comes from the
         Compose theme. -->
    <style name="Theme.MagicHandy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_ground</item>
        <item name="android:windowSplashScreenBackground">@color/window_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_ground</item>
    </style>
</resources>
